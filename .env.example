# CBrowser deployment.
# Run scripts/deploy.sh to generate secrets and start the stack.
CBROWSER_HTTPS_PORT=56661
# Migration: CBROWSER_PUBLIC_ORIGIN / CBROWSER_ALLOWED_ORIGINS are retired
# (t042).  The Origin whitelist is derived from the applied network version
# (network_config), never from the environment.  Delete any such lines from
# local .env files; old releases needing them are refused by rollback (no
# compat — rebuild the data directory).
