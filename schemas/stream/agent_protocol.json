{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "StreamAgentGatewayWireProtocol",
  "version": "v2",
  "messages": {
    "AgentRegisterEnvelope": {
      "$id": "#/$defs/AgentRegisterEnvelope",
      "$ref": "#/$defs/AgentRegisterEnvelope"
    },
    "AgentHeartbeatEnvelope": {
      "$id": "#/$defs/AgentHeartbeatEnvelope",
      "$ref": "#/$defs/AgentHeartbeatEnvelope"
    },
    "AgentHumanInputTakeoverEnvelope": {
      "$id": "#/$defs/AgentHumanInputTakeoverEnvelope",
      "$ref": "#/$defs/AgentHumanInputTakeoverEnvelope"
    },
    "GatewayRegisterResponse": {
      "$id": "#/$defs/GatewayRegisterResponse",
      "$ref": "#/$defs/GatewayRegisterResponse"
    },
    "GatewayTunnelEnvelope": {
      "$id": "#/$defs/GatewayTunnelEnvelope",
      "$ref": "#/$defs/GatewayTunnelEnvelope"
    },
    "GatewayControlEnvelope": {
      "$id": "#/$defs/GatewayControlEnvelope",
      "$ref": "#/$defs/GatewayControlEnvelope"
    }
  },
  "$defs": {
    "AgentHeartbeatEnvelope": {
      "additionalProperties": false,
      "properties": {
        "version": {
          "const": "v2",
          "default": "v2",
          "title": "Version",
          "type": "string"
        },
        "profile_id": {
          "title": "Profile Id",
          "type": "string"
        },
        "runtime_instance_id": {
          "title": "Runtime Instance Id",
          "type": "string"
        },
        "agent_session_id": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[a-zA-Z0-9_.:-]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Agent Session Id"
        },
        "conn_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Conn Id"
        },
        "timestamp": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Timestamp"
        },
        "action": {
          "const": "heartbeat",
          "default": "heartbeat",
          "title": "Action",
          "type": "string"
        },
        "payload": {
          "$ref": "#/$defs/AgentHeartbeatPayload"
        }
      },
      "required": [
        "profile_id",
        "runtime_instance_id",
        "payload"
      ],
      "title": "AgentHeartbeatEnvelope",
      "type": "object"
    },
    "AgentHeartbeatPayload": {
      "additionalProperties": false,
      "description": "Application-level health message sent every 10 seconds.\n\nThe video fields come from Selkies peer state, not from page reports.",
      "properties": {
        "runtime_state": {
          "enum": [
            "starting",
            "ready"
          ],
          "title": "Runtime State",
          "type": "string"
        },
        "viewer_count": {
          "minimum": 0,
          "title": "Viewer Count",
          "type": "integer"
        },
        "unpaused_video_consumers": {
          "minimum": 0,
          "title": "Unpaused Video Consumers",
          "type": "integer"
        },
        "capture_running": {
          "title": "Capture Running",
          "type": "boolean"
        }
      },
      "required": [
        "runtime_state",
        "viewer_count",
        "unpaused_video_consumers",
        "capture_running"
      ],
      "title": "AgentHeartbeatPayload",
      "type": "object"
    },
    "AgentHumanInputTakeoverEnvelope": {
      "additionalProperties": false,
      "properties": {
        "version": {
          "const": "v2",
          "default": "v2",
          "title": "Version",
          "type": "string"
        },
        "profile_id": {
          "title": "Profile Id",
          "type": "string"
        },
        "runtime_instance_id": {
          "title": "Runtime Instance Id",
          "type": "string"
        },
        "agent_session_id": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[a-zA-Z0-9_.:-]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Agent Session Id"
        },
        "conn_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Conn Id"
        },
        "timestamp": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Timestamp"
        },
        "action": {
          "const": "human_input_takeover",
          "default": "human_input_takeover",
          "title": "Action",
          "type": "string"
        },
        "payload": {
          "$ref": "#/$defs/HumanInputTakeoverPayload"
        }
      },
      "required": [
        "profile_id",
        "runtime_instance_id",
        "payload"
      ],
      "title": "AgentHumanInputTakeoverEnvelope",
      "type": "object"
    },
    "AgentRegisterEnvelope": {
      "additionalProperties": false,
      "properties": {
        "version": {
          "const": "v2",
          "default": "v2",
          "title": "Version",
          "type": "string"
        },
        "profile_id": {
          "title": "Profile Id",
          "type": "string"
        },
        "runtime_instance_id": {
          "title": "Runtime Instance Id",
          "type": "string"
        },
        "agent_session_id": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[a-zA-Z0-9_.:-]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Agent Session Id"
        },
        "conn_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Conn Id"
        },
        "timestamp": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Timestamp"
        },
        "action": {
          "const": "register",
          "default": "register",
          "title": "Action",
          "type": "string"
        },
        "payload": {
          "$ref": "#/$defs/AgentRegisterPayload"
        }
      },
      "required": [
        "profile_id",
        "runtime_instance_id",
        "payload"
      ],
      "title": "AgentRegisterEnvelope",
      "type": "object"
    },
    "AgentRegisterPayload": {
      "additionalProperties": false,
      "properties": {
        "hostname": {
          "title": "Hostname",
          "type": "string"
        },
        "profile_id": {
          "title": "Profile Id",
          "type": "string"
        },
        "runtime_instance_id": {
          "title": "Runtime Instance Id",
          "type": "string"
        },
        "udp_port": {
          "title": "Udp Port",
          "type": "integer"
        },
        "selkies_version": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Selkies Version",
          "type": "string"
        },
        "build_id": {
          "anyOf": [
            {
              "maxLength": 64,
              "pattern": "^[a-zA-Z0-9_.:-]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Build Id"
        },
        "runtime_state": {
          "enum": [
            "starting",
            "ready"
          ],
          "title": "Runtime State",
          "type": "string"
        },
        "config_version": {
          "minimum": 1,
          "title": "Config Version",
          "type": "integer"
        },
        "video_streaming_mode": {
          "default": false,
          "title": "Video Streaming Mode",
          "type": "boolean"
        },
        "width": {
          "default": 1920,
          "title": "Width",
          "type": "integer"
        },
        "height": {
          "default": 1080,
          "title": "Height",
          "type": "integer"
        }
      },
      "required": [
        "hostname",
        "profile_id",
        "runtime_instance_id",
        "udp_port",
        "selkies_version",
        "runtime_state",
        "config_version"
      ],
      "title": "AgentRegisterPayload",
      "type": "object"
    },
    "GatewayControlEnvelope": {
      "additionalProperties": false,
      "description": "Wire envelope for control plane packets from Gateway to StreamAgent.",
      "properties": {
        "version": {
          "const": "v2",
          "title": "Version",
          "type": "string"
        },
        "action": {
          "const": "supervisor_quota",
          "title": "Action",
          "type": "string"
        },
        "profile_id": {
          "title": "Profile Id",
          "type": "string"
        },
        "runtime_instance_id": {
          "title": "Runtime Instance Id",
          "type": "string"
        },
        "agent_session_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9_.:-]+$",
          "title": "Agent Session Id",
          "type": "string"
        },
        "conn_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Conn Id"
        },
        "payload": {
          "$ref": "#/$defs/SupervisorQuotaPayload"
        },
        "timestamp": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Timestamp"
        }
      },
      "required": [
        "version",
        "action",
        "profile_id",
        "runtime_instance_id",
        "agent_session_id"
      ],
      "title": "GatewayControlEnvelope",
      "type": "object"
    },
    "GatewayRegisterResponse": {
      "additionalProperties": false,
      "description": "Registration ACK from Gateway to StreamAgent.",
      "properties": {
        "version": {
          "const": "v2",
          "title": "Version",
          "type": "string"
        },
        "status": {
          "enum": [
            "ok",
            "error"
          ],
          "title": "Status",
          "type": "string"
        },
        "profile_id": {
          "title": "Profile Id",
          "type": "string"
        },
        "runtime_instance_id": {
          "title": "Runtime Instance Id",
          "type": "string"
        },
        "agent_session_id": {
          "anyOf": [
            {
              "maxLength": 128,
              "pattern": "^[a-zA-Z0-9_.:-]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Agent Session Id"
        },
        "error": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Error"
        },
        "gateway_build_id": {
          "anyOf": [
            {
              "maxLength": 64,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Gateway Build Id"
        },
        "rejection": {
          "anyOf": [
            {
              "$ref": "#/$defs/RegistrationRejection"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "version",
        "status",
        "profile_id",
        "runtime_instance_id"
      ],
      "title": "GatewayRegisterResponse",
      "type": "object"
    },
    "GatewayTunnelEnvelope": {
      "additionalProperties": false,
      "description": "Wire envelope for tunnel stream packets between Gateway and StreamAgent.",
      "properties": {
        "version": {
          "const": "v2",
          "title": "Version",
          "type": "string"
        },
        "type": {
          "enum": [
            "open",
            "msg",
            "close"
          ],
          "title": "Type",
          "type": "string"
        },
        "profile_id": {
          "title": "Profile Id",
          "type": "string"
        },
        "runtime_instance_id": {
          "title": "Runtime Instance Id",
          "type": "string"
        },
        "agent_session_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9_.:-]+$",
          "title": "Agent Session Id",
          "type": "string"
        },
        "conn_id": {
          "title": "Conn Id",
          "type": "string"
        },
        "data": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Data"
        },
        "code": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Code"
        },
        "reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason"
        }
      },
      "required": [
        "version",
        "type",
        "profile_id",
        "runtime_instance_id",
        "agent_session_id",
        "conn_id"
      ],
      "title": "GatewayTunnelEnvelope",
      "type": "object"
    },
    "HumanInputTakeoverPayload": {
      "additionalProperties": false,
      "description": "Classified foreground human input that must take over control.\n\nSent by the Stream Agent when its policy classifier observes a\ntakeover input (key press, mouse button, wheel, IME commit) from a\nforeground viewer. The Gateway forwards it to the API, which moves\nthe profile to the user and closes agent tunnels (t031).",
      "properties": {
        "input_kind": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Input Kind",
          "type": "string"
        },
        "viewer_conn_id": {
          "anyOf": [
            {
              "maxLength": 128,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Viewer Conn Id"
        }
      },
      "required": [
        "input_kind"
      ],
      "title": "HumanInputTakeoverPayload",
      "type": "object"
    },
    "RegistrationRejection": {
      "additionalProperties": false,
      "description": "Structured registration refusal (t026 AC-008).\n\n``code`` is the machine-readable reason the Supervisor's replacement\npolicy keys on; ``message`` is a bounded human diagnostic that never\ncarries credentials. ``gateway_build_id`` identifies the refusing\nGateway build; ``agent_build_id`` echoes what the Agent offered.",
      "properties": {
        "code": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[a-z0-9_]+$",
          "title": "Code",
          "type": "string"
        },
        "message": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Message",
          "type": "string"
        },
        "gateway_build_id": {
          "anyOf": [
            {
              "maxLength": 64,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Gateway Build Id"
        },
        "agent_build_id": {
          "anyOf": [
            {
              "maxLength": 64,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Agent Build Id"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "title": "RegistrationRejection",
      "type": "object"
    },
    "SupervisorQuotaPayload": {
      "additionalProperties": false,
      "properties": {
        "max_fps_cap": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Fps Cap"
        },
        "reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason"
        }
      },
      "title": "SupervisorQuotaPayload",
      "type": "object"
    }
  }
}
