{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BrowserAgentProtocol",
  "description": "Cross-service Unix Domain Socket contract for CBrowser Runtime Agent",
  "version": "2.0.0",
  "definitions": {
    "HealthResponse": {
      "type": "object",
      "required": [
        "status",
        "ready",
        "display_ready",
        "browser_ready",
        "audio_ready",
        "cdp_ready",
        "profile_id",
        "runtime_instance_id",
        "config_version"
      ],
      "additionalProperties": false,
      "properties": {
        "status": {
          "type": "string",
          "enum": ["ok", "degraded", "error"]
        },
        "ready": {
          "type": "boolean"
        },
        "display_ready": {
          "type": "boolean"
        },
        "browser_ready": {
          "type": "boolean"
        },
        "audio_ready": {
          "type": "boolean"
        },
        "cdp_ready": {
          "type": "boolean"
        },
        "profile_id": {
          "type": "string"
        },
        "runtime_instance_id": {
          "type": "string"
        },
        "config_version": {
          "type": "integer",
          "minimum": 1
        },
        "details": {
          "type": "object",
          "additionalProperties": true
        }
      }
    },
    "ConfigVersionResponse": {
      "type": "object",
      "required": [
        "profile_id",
        "runtime_instance_id",
        "config_version"
      ],
      "additionalProperties": false,
      "properties": {
        "profile_id": {
          "type": "string"
        },
        "runtime_instance_id": {
          "type": "string"
        },
        "config_version": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "ControlRequest": {
      "type": "object",
      "required": ["action"],
      "additionalProperties": false,
      "properties": {
        "action": {
          "type": "string",
          "enum": ["close", "rearm_downloads"]
        },
        "params": {
          "type": "object",
          "additionalProperties": true
        }
      }
    },
    "ControlResponse": {
      "type": "object",
      "required": ["status", "action"],
      "additionalProperties": false,
      "properties": {
        "status": {
          "type": "string",
          "enum": ["ok", "error"]
        },
        "action": {
          "type": "string"
        },
        "message": {
          "type": ["string", "null"]
        }
      }
    },
    "RuntimeEventRecord": {
      "type": "object",
      "required": [
        "event_id",
        "profile_id",
        "runtime_instance_id",
        "event_type",
        "config_version",
        "created_at"
      ],
      "additionalProperties": false,
      "properties": {
        "event_id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_\\-\\.:]{1,128}$"
        },
        "profile_id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_\\-\\.:]{1,128}$"
        },
        "runtime_instance_id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_\\-\\.:]{1,128}$"
        },
        "event_type": {
          "type": "string",
          "enum": ["exit", "heartbeat", "lifecycle"]
        },
        "exit_code": {
          "type": ["integer", "null"]
        },
        "exit_reason": {
          "type": ["string", "null"],
          "maxLength": 128
        },
        "config_version": {
          "type": "integer",
          "minimum": 1
        },
        "payload": {
          "type": "object",
          "additionalProperties": true
        },
        "created_at": {
          "type": "string"
        }
      }
    },
    "DownloadEventRecord": {
      "type": "object",
      "required": [
        "event_id",
        "profile_id",
        "runtime_instance_id",
        "guid",
        "state",
        "created_at"
      ],
      "additionalProperties": false,
      "properties": {
        "event_id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_\\-\\.:]{1,128}$"
        },
        "profile_id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_\\-\\.:]{1,128}$"
        },
        "runtime_instance_id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_\\-\\.:]{1,128}$"
        },
        "guid": {
          "type": "string"
        },
        "url": {
          "type": ["string", "null"]
        },
        "suggested_filename": {
          "type": ["string", "null"]
        },
        "download_path": {
          "type": ["string", "null"]
        },
        "state": {
          "type": "string",
          "enum": ["in_progress", "completed", "canceled"]
        },
        "received_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "total_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "created_at": {
          "type": "string"
        }
      }
    }
  }
}
