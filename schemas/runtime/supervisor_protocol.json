{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SupervisorControlProtocol",
  "version": "1.0.0",
  "messages": {
    "StartProfileRequest": {
      "$id": "#/$defs/StartProfileRequest",
      "$ref": "#/$defs/StartProfileRequest"
    },
    "StartProfileResponse": {
      "$id": "#/$defs/StartProfileResponse",
      "$ref": "#/$defs/StartProfileResponse"
    },
    "StopProfileRequest": {
      "$id": "#/$defs/StopProfileRequest",
      "$ref": "#/$defs/StopProfileRequest"
    },
    "StopProfileResponse": {
      "$id": "#/$defs/StopProfileResponse",
      "$ref": "#/$defs/StopProfileResponse"
    },
    "SearchDefaultsRetryRequest": {
      "$id": "#/$defs/SearchDefaultsRetryRequest",
      "$ref": "#/$defs/SearchDefaultsRetryRequest"
    },
    "SearchDefaultsStatusResponse": {
      "$id": "#/$defs/SearchDefaultsStatusResponse",
      "$ref": "#/$defs/SearchDefaultsStatusResponse"
    },
    "PreviewPolicySyncResponse": {
      "$id": "#/$defs/PreviewPolicySyncResponse",
      "$ref": "#/$defs/PreviewPolicySyncResponse"
    },
    "ResetBlockedRequest": {
      "$id": "#/$defs/ResetBlockedRequest",
      "$ref": "#/$defs/ResetBlockedRequest"
    },
    "EgressProbeRequest": {
      "$id": "#/$defs/EgressProbeRequest",
      "$ref": "#/$defs/EgressProbeRequest"
    },
    "EgressProbeResponse": {
      "$id": "#/$defs/EgressProbeResponse",
      "$ref": "#/$defs/EgressProbeResponse"
    },
    "CloseTunnelsRequest": {
      "$id": "#/$defs/CloseTunnelsRequest",
      "$ref": "#/$defs/CloseTunnelsRequest"
    },
    "CloseTunnelsResponse": {
      "$id": "#/$defs/CloseTunnelsResponse",
      "$ref": "#/$defs/CloseTunnelsResponse"
    },
    "AttendantDialogsResponse": {
      "$id": "#/$defs/AttendantDialogsResponse",
      "$ref": "#/$defs/AttendantDialogsResponse"
    },
    "AnswerAttendantDialogRequest": {
      "$id": "#/$defs/AnswerAttendantDialogRequest",
      "$ref": "#/$defs/AnswerAttendantDialogRequest"
    },
    "AnswerAttendantDialogResponse": {
      "$id": "#/$defs/AnswerAttendantDialogResponse",
      "$ref": "#/$defs/AnswerAttendantDialogResponse"
    },
    "ResetBlockedResponse": {
      "$id": "#/$defs/ResetBlockedResponse",
      "$ref": "#/$defs/ResetBlockedResponse"
    },
    "ProfileRuntimeStatus": {
      "$id": "#/$defs/ProfileRuntimeStatus",
      "$ref": "#/$defs/ProfileRuntimeStatus"
    },
    "TransportObservation": {
      "$id": "#/$defs/TransportObservation",
      "$ref": "#/$defs/TransportObservation"
    },
    "TransportObservationResponse": {
      "$id": "#/$defs/TransportObservationResponse",
      "$ref": "#/$defs/TransportObservationResponse"
    },
    "ReconcileAllResponse": {
      "$id": "#/$defs/ReconcileAllResponse",
      "$ref": "#/$defs/ReconcileAllResponse"
    },
    "ProfileReadiness": {
      "$id": "#/$defs/ProfileReadiness",
      "$ref": "#/$defs/ProfileReadiness"
    },
    "ReadinessResponse": {
      "$id": "#/$defs/ReadinessResponse",
      "$ref": "#/$defs/ReadinessResponse"
    },
    "RebuildEdgeRequest": {
      "$id": "#/$defs/RebuildEdgeRequest",
      "$ref": "#/$defs/RebuildEdgeRequest"
    },
    "ConvergeStreamsRequest": {
      "$id": "#/$defs/ConvergeStreamsRequest",
      "$ref": "#/$defs/ConvergeStreamsRequest"
    }
  },
  "$defs": {
    "AnswerAttendantDialogRequest": {
      "additionalProperties": false,
      "description": "t031: answer a held dialog through the attendant's session.",
      "properties": {
        "target_id": {
          "minLength": 1,
          "title": "Target Id",
          "type": "string"
        },
        "accept": {
          "default": false,
          "title": "Accept",
          "type": "boolean"
        },
        "prompt_text": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Prompt Text"
        }
      },
      "required": [
        "target_id"
      ],
      "title": "AnswerAttendantDialogRequest",
      "type": "object"
    },
    "AnswerAttendantDialogResponse": {
      "additionalProperties": false,
      "properties": {
        "profile_id": {
          "title": "Profile Id",
          "type": "string"
        },
        "dialog": {
          "additionalProperties": true,
          "title": "Dialog",
          "type": "object"
        },
        "action": {
          "title": "Action",
          "type": "string"
        }
      },
      "required": [
        "profile_id",
        "dialog",
        "action"
      ],
      "title": "AnswerAttendantDialogResponse",
      "type": "object"
    },
    "AttendantDialogsResponse": {
      "additionalProperties": false,
      "description": "t031: held dialogs peeked from the resident attendant.",
      "properties": {
        "profile_id": {
          "title": "Profile Id",
          "type": "string"
        },
        "dialogs": {
          "items": {
            "additionalProperties": true,
            "type": "object"
          },
          "title": "Dialogs",
          "type": "array"
        }
      },
      "required": [
        "profile_id"
      ],
      "title": "AttendantDialogsResponse",
      "type": "object"
    },
    "CloseTunnelsRequest": {
      "additionalProperties": false,
      "description": "t031: close every Supervisor-layer tunnel for a profile.\n\n``generation`` is the post-takeover control generation: the fence\nadvances to it monotonically, so later forwarded handshakes at or\nbelow it are stale and rejected.",
      "properties": {
        "generation": {
          "minimum": 0,
          "title": "Generation",
          "type": "integer"
        }
      },
      "required": [
        "generation"
      ],
      "title": "CloseTunnelsRequest",
      "type": "object"
    },
    "CloseTunnelsResponse": {
      "additionalProperties": false,
      "properties": {
        "profile_id": {
          "title": "Profile Id",
          "type": "string"
        },
        "generation": {
          "title": "Generation",
          "type": "integer"
        },
        "closed_tunnel_ids": {
          "items": {
            "type": "string"
          },
          "title": "Closed Tunnel Ids",
          "type": "array"
        },
        "attendant_released": {
          "default": false,
          "title": "Attendant Released",
          "type": "boolean"
        }
      },
      "required": [
        "profile_id",
        "generation"
      ],
      "title": "CloseTunnelsResponse",
      "type": "object"
    },
    "ConvergeStreamsRequest": {
      "additionalProperties": false,
      "properties": {
        "target_version": {
          "minimum": 1,
          "title": "Target Version",
          "type": "integer"
        },
        "bind_host": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Bind Host",
          "type": "string"
        },
        "advertised_ip": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Advertised Ip",
          "type": "string"
        }
      },
      "required": [
        "target_version",
        "bind_host",
        "advertised_ip"
      ],
      "title": "ConvergeStreamsRequest",
      "type": "object"
    },
    "EgressProbeRequest": {
      "additionalProperties": false,
      "description": "t052: Supervisor-side probe request (control plane only).\n\nCarries the stored endpoint + credentials so the helper container can\npresent them to the upstream proxy.  Never logged; never exposed on\nthe public API (which accepts only the proxy id).",
      "properties": {
        "scheme": {
          "enum": [
            "http",
            "https",
            "socks5"
          ],
          "title": "Scheme",
          "type": "string"
        },
        "host": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Host",
          "type": "string"
        },
        "port": {
          "maximum": 65535,
          "minimum": 1,
          "title": "Port",
          "type": "integer"
        },
        "username": {
          "anyOf": [
            {
              "maxLength": 255,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Username"
        },
        "password": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Password"
        },
        "credential_revision": {
          "minimum": 1,
          "title": "Credential Revision",
          "type": "integer"
        },
        "endpoint_fingerprint": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Endpoint Fingerprint",
          "type": "string"
        }
      },
      "required": [
        "scheme",
        "host",
        "port",
        "credential_revision",
        "endpoint_fingerprint"
      ],
      "title": "EgressProbeRequest",
      "type": "object"
    },
    "EgressProbeResponse": {
      "additionalProperties": false,
      "properties": {
        "proxy_id": {
          "title": "Proxy Id",
          "type": "string"
        },
        "status": {
          "enum": [
            "ok",
            "failed"
          ],
          "title": "Status",
          "type": "string"
        },
        "egress_ip": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Egress Ip"
        },
        "country_code": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Country Code"
        },
        "error_code": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Error Code"
        }
      },
      "required": [
        "proxy_id",
        "status"
      ],
      "title": "EgressProbeResponse",
      "type": "object"
    },
    "PreviewPolicySyncResponse": {
      "additionalProperties": false,
      "properties": {
        "status": {
          "const": "ok",
          "default": "ok",
          "title": "Status",
          "type": "string"
        }
      },
      "title": "PreviewPolicySyncResponse",
      "type": "object"
    },
    "ProfileReadiness": {
      "additionalProperties": false,
      "properties": {
        "profile_id": {
          "title": "Profile Id",
          "type": "string"
        },
        "runtime_instance_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Runtime Instance Id"
        },
        "ready": {
          "default": false,
          "title": "Ready",
          "type": "boolean"
        },
        "checks": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ]
          },
          "title": "Checks",
          "type": "object"
        },
        "diagnostics": {
          "items": {
            "type": "string"
          },
          "title": "Diagnostics",
          "type": "array"
        }
      },
      "required": [
        "profile_id"
      ],
      "title": "ProfileReadiness",
      "type": "object"
    },
    "ProfileRuntimeStatus": {
      "additionalProperties": false,
      "properties": {
        "profile_id": {
          "title": "Profile Id",
          "type": "string"
        },
        "runtime_instance_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Runtime Instance Id"
        },
        "observed_state": {
          "default": "stopped",
          "enum": [
            "stopped",
            "starting",
            "running",
            "stopping",
            "error"
          ],
          "title": "Observed State",
          "type": "string"
        },
        "desired_state": {
          "default": "stopped",
          "enum": [
            "stopped",
            "running"
          ],
          "title": "Desired State",
          "type": "string"
        },
        "udp_mux_port": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Udp Mux Port"
        },
        "browser_container_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Browser Container Id"
        },
        "stream_container_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Stream Container Id"
        },
        "restart_blocked": {
          "default": false,
          "title": "Restart Blocked",
          "type": "boolean"
        },
        "failure_count": {
          "default": 0,
          "title": "Failure Count",
          "type": "integer"
        }
      },
      "required": [
        "profile_id"
      ],
      "title": "ProfileRuntimeStatus",
      "type": "object"
    },
    "ReadinessResponse": {
      "additionalProperties": false,
      "properties": {
        "ready": {
          "default": false,
          "title": "Ready",
          "type": "boolean"
        },
        "reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason"
        },
        "profiles": {
          "items": {
            "$ref": "#/$defs/ProfileReadiness"
          },
          "title": "Profiles",
          "type": "array"
        }
      },
      "title": "ReadinessResponse",
      "type": "object"
    },
    "RebuildEdgeRequest": {
      "additionalProperties": false,
      "properties": {
        "target_version": {
          "minimum": 1,
          "title": "Target Version",
          "type": "integer"
        },
        "bind_host": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Bind Host",
          "type": "string"
        },
        "https_port": {
          "maximum": 65535,
          "minimum": 1,
          "title": "Https Port",
          "type": "integer"
        },
        "caddyfile_path": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
          "title": "Caddyfile Path",
          "type": "string"
        }
      },
      "required": [
        "target_version",
        "bind_host",
        "https_port",
        "caddyfile_path"
      ],
      "title": "RebuildEdgeRequest",
      "type": "object"
    },
    "ReconcileAllResponse": {
      "additionalProperties": false,
      "properties": {
        "scanned": {
          "default": 0,
          "title": "Scanned",
          "type": "integer"
        },
        "profiles": {
          "items": {
            "type": "string"
          },
          "title": "Profiles",
          "type": "array"
        }
      },
      "title": "ReconcileAllResponse",
      "type": "object"
    },
    "ResetBlockedRequest": {
      "additionalProperties": false,
      "properties": {
        "profile_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Profile Id",
          "type": "string"
        }
      },
      "required": [
        "profile_id"
      ],
      "title": "ResetBlockedRequest",
      "type": "object"
    },
    "ResetBlockedResponse": {
      "additionalProperties": false,
      "properties": {
        "profile_id": {
          "title": "Profile Id",
          "type": "string"
        },
        "status": {
          "default": "ok",
          "title": "Status",
          "type": "string"
        },
        "message": {
          "default": "Restart block cleared",
          "title": "Message",
          "type": "string"
        }
      },
      "required": [
        "profile_id"
      ],
      "title": "ResetBlockedResponse",
      "type": "object"
    },
    "SearchDefaultsRetryRequest": {
      "additionalProperties": false,
      "properties": {
        "profile_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Profile Id",
          "type": "string"
        },
        "runtime_instance_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Runtime Instance Id",
          "type": "string"
        },
        "request_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Request Id",
          "type": "string"
        }
      },
      "required": [
        "profile_id",
        "runtime_instance_id",
        "request_id"
      ],
      "title": "SearchDefaultsRetryRequest",
      "type": "object"
    },
    "SearchDefaultsStatus": {
      "additionalProperties": false,
      "description": "Independent outcome of the best-effort default-search initialization.",
      "properties": {
        "state": {
          "enum": [
            "applied",
            "failed",
            "disabled",
            "pending"
          ],
          "title": "State",
          "type": "string"
        },
        "error_kind": {
          "anyOf": [
            {
              "maxLength": 64,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Error Kind"
        },
        "runtime_instance_id": {
          "title": "Runtime Instance Id",
          "type": "string"
        },
        "request_id": {
          "anyOf": [
            {
              "maxLength": 128,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Request Id"
        },
        "updated_at": {
          "title": "Updated At",
          "type": "string"
        }
      },
      "required": [
        "state",
        "runtime_instance_id",
        "updated_at"
      ],
      "title": "SearchDefaultsStatus",
      "type": "object"
    },
    "SearchDefaultsStatusResponse": {
      "additionalProperties": false,
      "properties": {
        "profile_id": {
          "title": "Profile Id",
          "type": "string"
        },
        "runtime_instance_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Runtime Instance Id"
        },
        "search_defaults": {
          "anyOf": [
            {
              "$ref": "#/$defs/SearchDefaultsStatus"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "profile_id"
      ],
      "title": "SearchDefaultsStatusResponse",
      "type": "object"
    },
    "StartProfileRequest": {
      "additionalProperties": false,
      "properties": {
        "profile_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Profile Id",
          "type": "string"
        },
        "profile_number": {
          "minimum": 1,
          "title": "Profile Number",
          "type": "integer"
        },
        "config_version": {
          "default": 1,
          "minimum": 1,
          "title": "Config Version",
          "type": "integer"
        },
        "force": {
          "default": false,
          "title": "Force",
          "type": "boolean"
        },
        "operation_id": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Operation Id"
        }
      },
      "required": [
        "profile_id",
        "profile_number"
      ],
      "title": "StartProfileRequest",
      "type": "object"
    },
    "StartProfileResponse": {
      "additionalProperties": false,
      "properties": {
        "profile_id": {
          "title": "Profile Id",
          "type": "string"
        },
        "status": {
          "enum": [
            "starting",
            "running"
          ],
          "title": "Status",
          "type": "string"
        },
        "runtime_instance_id": {
          "title": "Runtime Instance Id",
          "type": "string"
        },
        "udp_mux_port": {
          "maximum": 30991,
          "minimum": 30000,
          "title": "Udp Mux Port",
          "type": "integer"
        },
        "browser_container": {
          "title": "Browser Container",
          "type": "string"
        },
        "stream_container": {
          "title": "Stream Container",
          "type": "string"
        }
      },
      "required": [
        "profile_id",
        "status",
        "runtime_instance_id",
        "udp_mux_port",
        "browser_container",
        "stream_container"
      ],
      "title": "StartProfileResponse",
      "type": "object"
    },
    "StopProfileRequest": {
      "additionalProperties": false,
      "properties": {
        "profile_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Profile Id",
          "type": "string"
        },
        "runtime_instance_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Runtime Instance Id",
          "type": "string"
        },
        "operation_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Operation Id",
          "type": "string"
        }
      },
      "required": [
        "profile_id",
        "runtime_instance_id",
        "operation_id"
      ],
      "title": "StopProfileRequest",
      "type": "object"
    },
    "StopProfileResponse": {
      "additionalProperties": false,
      "properties": {
        "profile_id": {
          "title": "Profile Id",
          "type": "string"
        },
        "runtime_instance_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Runtime Instance Id"
        },
        "status": {
          "enum": [
            "stopped",
            "already_absent",
            "superseded_noop"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "profile_id",
        "status"
      ],
      "title": "StopProfileResponse",
      "type": "object"
    },
    "TransportObservation": {
      "additionalProperties": false,
      "description": "Layered runtime observation for one Profile (t026 AC-010).\n\nBrowser/Stream are process layers; transport is the media/signaling\npath between them and the viewer (Gateway attachment, policy and\nAgent registration). Held in memory by the Supervisor and the API;\nnever persisted. ``unknown`` is the honest value before the first\nreport of a generation.",
      "properties": {
        "profile_id": {
          "title": "Profile Id",
          "type": "string"
        },
        "runtime_instance_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Runtime Instance Id"
        },
        "browser_state": {
          "default": "unknown",
          "enum": [
            "running",
            "stopped",
            "missing",
            "error",
            "unknown"
          ],
          "title": "Browser State",
          "type": "string"
        },
        "stream_state": {
          "default": "unknown",
          "enum": [
            "running",
            "stopped",
            "missing",
            "error",
            "unknown"
          ],
          "title": "Stream State",
          "type": "string"
        },
        "transport_state": {
          "default": "unknown",
          "enum": [
            "ready",
