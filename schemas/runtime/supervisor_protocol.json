{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SupervisorControlProtocol",
  "version": "1.0.0",
  "messages": {
    "StartProfileRequest": {
      "$id": "#/$defs/StartProfileRequest",
      "$ref": "#/$defs/StartProfileRequest"
    },
    "StartProfileResponse": {
      "$id": "#/$defs/StartProfileResponse",
      "$ref": "#/$defs/StartProfileResponse"
    },
    "StopProfileRequest": {
      "$id": "#/$defs/StopProfileRequest",
      "$ref": "#/$defs/StopProfileRequest"
    },
    "StopProfileResponse": {
      "$id": "#/$defs/StopProfileResponse",
      "$ref": "#/$defs/StopProfileResponse"
    },
    "ResetBlockedRequest": {
      "$id": "#/$defs/ResetBlockedRequest",
      "$ref": "#/$defs/ResetBlockedRequest"
    },
    "ResetBlockedResponse": {
      "$id": "#/$defs/ResetBlockedResponse",
      "$ref": "#/$defs/ResetBlockedResponse"
    },
    "ProfileRuntimeStatus": {
      "$id": "#/$defs/ProfileRuntimeStatus",
      "$ref": "#/$defs/ProfileRuntimeStatus"
    },
    "SearchDefaultsRetryRequest": {
      "$id": "#/$defs/SearchDefaultsRetryRequest",
      "$ref": "#/$defs/SearchDefaultsRetryRequest"
    },
    "SearchDefaultsStatusResponse": {
      "$id": "#/$defs/SearchDefaultsStatusResponse",
      "$ref": "#/$defs/SearchDefaultsStatusResponse"
    },
    "TransportObservation": {
      "$id": "#/$defs/TransportObservation",
      "$ref": "#/$defs/TransportObservation"
    },
    "TransportObservationResponse": {
      "$id": "#/$defs/TransportObservationResponse",
      "$ref": "#/$defs/TransportObservationResponse"
    },
    "ReconcileAllResponse": {
      "$id": "#/$defs/ReconcileAllResponse",
      "$ref": "#/$defs/ReconcileAllResponse"
    },
    "ProfileReadiness": {
      "$id": "#/$defs/ProfileReadiness",
      "$ref": "#/$defs/ProfileReadiness"
    },
    "ReadinessResponse": {
      "$id": "#/$defs/ReadinessResponse",
      "$ref": "#/$defs/ReadinessResponse"
    }
  },
  "$defs": {
    "ProfileReadiness": {
      "additionalProperties": false,
      "properties": {
        "profile_id": {
          "title": "Profile Id",
          "type": "string"
        },
        "runtime_instance_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Runtime Instance Id"
        },
        "ready": {
          "default": false,
          "title": "Ready",
          "type": "boolean"
        },
        "checks": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ]
          },
          "title": "Checks",
          "type": "object"
        },
        "diagnostics": {
          "items": {
            "type": "string"
          },
          "title": "Diagnostics",
          "type": "array"
        }
      },
      "required": [
        "profile_id"
      ],
      "title": "ProfileReadiness",
      "type": "object"
    },
    "ProfileRuntimeStatus": {
      "additionalProperties": false,
      "properties": {
        "profile_id": {
          "title": "Profile Id",
          "type": "string"
        },
        "runtime_instance_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Runtime Instance Id"
        },
        "observed_state": {
          "default": "stopped",
          "enum": [
            "stopped",
            "starting",
            "running",
            "stopping",
            "error"
          ],
          "title": "Observed State",
          "type": "string"
        },
        "desired_state": {
          "default": "stopped",
          "enum": [
            "stopped",
            "running"
          ],
          "title": "Desired State",
          "type": "string"
        },
        "udp_mux_port": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Udp Mux Port"
        },
        "browser_container_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Browser Container Id"
        },
        "stream_container_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Stream Container Id"
        },
        "restart_blocked": {
          "default": false,
          "title": "Restart Blocked",
          "type": "boolean"
        },
        "failure_count": {
          "default": 0,
          "title": "Failure Count",
          "type": "integer"
        }
      },
      "required": [
        "profile_id"
      ],
      "title": "ProfileRuntimeStatus",
      "type": "object"
    },
    "ReadinessResponse": {
      "additionalProperties": false,
      "properties": {
        "ready": {
          "default": false,
          "title": "Ready",
          "type": "boolean"
        },
        "reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason"
        },
        "profiles": {
          "items": {
            "$ref": "#/$defs/ProfileReadiness"
          },
          "title": "Profiles",
          "type": "array"
        }
      },
      "title": "ReadinessResponse",
      "type": "object"
    },
    "ReconcileAllResponse": {
      "additionalProperties": false,
      "properties": {
        "scanned": {
          "default": 0,
          "title": "Scanned",
          "type": "integer"
        },
        "profiles": {
          "items": {
            "type": "string"
          },
          "title": "Profiles",
          "type": "array"
        }
      },
      "title": "ReconcileAllResponse",
      "type": "object"
    },
    "ResetBlockedRequest": {
      "additionalProperties": false,
      "properties": {
        "profile_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Profile Id",
          "type": "string"
        }
      },
      "required": [
        "profile_id"
      ],
      "title": "ResetBlockedRequest",
      "type": "object"
    },
    "ResetBlockedResponse": {
      "additionalProperties": false,
      "properties": {
        "profile_id": {
          "title": "Profile Id",
          "type": "string"
        },
        "status": {
          "default": "ok",
          "title": "Status",
          "type": "string"
        },
        "message": {
          "default": "Restart block cleared",
          "title": "Message",
          "type": "string"
        }
      },
      "required": [
        "profile_id"
      ],
      "title": "ResetBlockedResponse",
      "type": "object"
    },
    "SearchDefaultsRetryRequest": {
      "additionalProperties": false,
      "properties": {
        "profile_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Profile Id",
          "type": "string"
        },
        "runtime_instance_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Runtime Instance Id",
          "type": "string"
        },
        "request_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Request Id",
          "type": "string"
        }
      },
      "required": [
        "profile_id",
        "runtime_instance_id",
        "request_id"
      ],
      "title": "SearchDefaultsRetryRequest",
      "type": "object"
    },
    "SearchDefaultsStatus": {
      "additionalProperties": false,
      "description": "Independent outcome of the best-effort default-search initialization.",
      "properties": {
        "state": {
          "enum": [
            "applied",
            "failed",
            "disabled",
            "pending"
          ],
          "title": "State",
          "type": "string"
        },
        "error_kind": {
          "anyOf": [
            {
              "maxLength": 64,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Error Kind"
        },
        "runtime_instance_id": {
          "title": "Runtime Instance Id",
          "type": "string"
        },
        "request_id": {
          "anyOf": [
            {
              "maxLength": 128,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Request Id"
        },
        "updated_at": {
          "title": "Updated At",
          "type": "string"
        }
      },
      "required": [
        "state",
        "runtime_instance_id",
        "updated_at"
      ],
      "title": "SearchDefaultsStatus",
      "type": "object"
    },
    "SearchDefaultsStatusResponse": {
      "additionalProperties": false,
      "properties": {
        "profile_id": {
          "title": "Profile Id",
          "type": "string"
        },
        "runtime_instance_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Runtime Instance Id"
        },
        "search_defaults": {
          "anyOf": [
            {
              "$ref": "#/$defs/SearchDefaultsStatus"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "profile_id"
      ],
      "title": "SearchDefaultsStatusResponse",
      "type": "object"
    },
    "StartProfileRequest": {
      "additionalProperties": false,
      "properties": {
        "profile_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Profile Id",
          "type": "string"
        },
        "config_version": {
          "default": 1,
          "minimum": 1,
          "title": "Config Version",
          "type": "integer"
        },
        "force": {
          "default": false,
          "title": "Force",
          "type": "boolean"
        },
        "operation_id": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Operation Id"
        }
      },
      "required": [
        "profile_id"
      ],
      "title": "StartProfileRequest",
      "type": "object"
    },
    "StartProfileResponse": {
      "additionalProperties": false,
      "properties": {
        "profile_id": {
          "title": "Profile Id",
          "type": "string"
        },
        "status": {
          "enum": [
            "starting",
            "running"
          ],
          "title": "Status",
          "type": "string"
        },
        "runtime_instance_id": {
          "title": "Runtime Instance Id",
          "type": "string"
        },
        "udp_mux_port": {
          "maximum": 30991,
          "minimum": 30000,
          "title": "Udp Mux Port",
          "type": "integer"
        },
        "browser_container": {
          "title": "Browser Container",
          "type": "string"
        },
        "stream_container": {
          "title": "Stream Container",
          "type": "string"
        }
      },
      "required": [
        "profile_id",
        "status",
        "runtime_instance_id",
        "udp_mux_port",
        "browser_container",
        "stream_container"
      ],
      "title": "StartProfileResponse",
      "type": "object"
    },
    "StopProfileRequest": {
      "additionalProperties": false,
      "properties": {
        "profile_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Profile Id",
          "type": "string"
        },
        "runtime_instance_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Runtime Instance Id",
          "type": "string"
        },
        "operation_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Operation Id",
          "type": "string"
        }
      },
      "required": [
        "profile_id",
        "runtime_instance_id",
        "operation_id"
      ],
      "title": "StopProfileRequest",
      "type": "object"
    },
    "StopProfileResponse": {
      "additionalProperties": false,
      "properties": {
        "profile_id": {
          "title": "Profile Id",
          "type": "string"
        },
        "runtime_instance_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Runtime Instance Id"
        },
        "status": {
          "enum": [
            "stopped",
            "already_absent",
            "superseded_noop"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "profile_id",
        "status"
      ],
      "title": "StopProfileResponse",
      "type": "object"
    },
    "TransportObservation": {
      "additionalProperties": false,
      "description": "Layered runtime observation for one Profile (t026 AC-010).\n\nBrowser/Stream are process layers; transport is the media/signaling\npath between them and the viewer (Gateway attachment, policy and\nAgent registration). Held in memory by the Supervisor and the API;\nnever persisted. ``unknown`` is the honest value before the first\nreport of a generation.",
      "properties": {
        "profile_id": {
          "title": "Profile Id",
          "type": "string"
        },
        "runtime_instance_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Runtime Instance Id"
        },
        "browser_state": {
          "default": "unknown",
          "enum": [
            "running",
            "stopped",
            "missing",
            "error",
            "unknown"
          ],
          "title": "Browser State",
          "type": "string"
        },
        "stream_state": {
          "default": "unknown",
          "enum": [
            "running",
            "stopped",
            "missing",
            "error",
            "unknown"
          ],
          "title": "Stream State",
          "type": "string"
        },
        "transport_state": {
          "default": "unknown",
          "enum": [
            "ready",
            "recovering",
            "failed",
            "unknown"
          ],
          "title": "Transport State",
          "type": "string"
        },
        "protocol_version": {
          "anyOf": [
            {
              "maxLength": 16,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Protocol Version"
        },
        "selkies_version": {
          "anyOf": [
            {
              "maxLength": 64,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Selkies Version"
        },
        "agent_build_id": {
          "anyOf": [
            {
              "maxLength": 64,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Agent Build Id"
        },
        "gateway_build_id": {
          "anyOf": [
            {
              "maxLength": 64,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Gateway Build Id"
        },
        "config_version": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Config Version"
        },
        "gateway_endpoint": {
          "anyOf": [
            {
              "maxLength": 64,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Gateway Endpoint"
        },
        "last_attached_at": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Last Attached At"
        },
        "last_registered_at": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Last Registered At"
        },
        "last_error": {
          "anyOf": [
            {
              "maxLength": 256,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Last Error"
        },
        "last_error_at": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Last Error At"
        },
        "rejection_code": {
          "anyOf": [
            {
              "maxLength": 64,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rejection Code"
        }
      },
      "required": [
        "profile_id"
      ],
      "title": "TransportObservation",
      "type": "object"
    },
    "TransportObservationResponse": {
      "additionalProperties": false,
      "properties": {
        "profile_id": {
          "title": "Profile Id",
          "type": "string"
        },
        "runtime_instance_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Runtime Instance Id"
        },
        "transport": {
          "anyOf": [
            {
              "$ref": "#/$defs/TransportObservation"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "profile_id"
      ],
      "title": "TransportObservationResponse",
      "type": "object"
    }
  }
}
