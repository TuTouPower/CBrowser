{
  "name": "cbrowser",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=26.0.0 <27"
  },
  "scripts": {
    "dev": "vite",
    "check:node": "node scripts/check_node.mjs",
    "vendor:selkies": "python3 ../../scripts/vendor_selkies_web.py",
    "verify:selkies": "python3 ../../scripts/verify_frontend_dist.py --check-freshness",
    "prebuild": "npm run vendor:selkies",
    "build": "npm run check:node && tsc -b && vite build && vite build --config vite.selkies.config.ts",
    "postbuild": "python3 ../../scripts/write_frontend_build_stamp.py && npm run verify:selkies",
    "preview": "vite preview",
    "pretest": "npm run check:node",
    "test": "npm run test:types && vitest run",
    "test:watch": "vitest",
    "generate:api": "openapi-typescript ../../schemas/openapi/cbrowser_v1.json -o src/shared/api/generated/cbrowser_v1.d.ts",
    "test:types": "tsc -p tsconfig.test.json",
    "design:tokens": "node scripts/design_tokens.mjs --write",
    "design:lint": "node scripts/design_tokens.mjs --lint",
    "design:check": "node scripts/design_tokens.mjs --check"
  },
  "dependencies": {
    "@fontsource-variable/space-grotesk": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@radix-ui/react-checkbox": "1.4.1",
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-dropdown-menu": "2.2.1",
    "@radix-ui/react-popover": "1.3.1",
    "@radix-ui/react-select": "2.4.1",
    "@radix-ui/react-switch": "1.4.1",
    "@radix-ui/react-toast": "1.3.1",
    "@radix-ui/react-tooltip": "1.4.1",
    "@tanstack/react-query": "^5.106.0",
    "lucide-react": "^1.68.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1"
  },
  "devDependencies": {
    "@google/design.md": "0.4.0",
    "@tailwindcss/vite": "4.3.4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "jsdom": "^30.1.3",
    "openapi-typescript": "^7.13.0",
    "tailwindcss": "4.3.4",
    "typescript": "~5.9.3",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  }
}
