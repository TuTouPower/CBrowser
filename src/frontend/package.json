{
  "name": "cbrowser",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=26.0.0 <27"
  },
  "scripts": {
    "dev": "vite",
    "check:node": "node scripts/check_node.mjs",
    "vendor:selkies": "python3 ../../scripts/vendor_selkies_web.py",
    "verify:selkies": "python3 ../../scripts/verify_frontend_dist.py --check-freshness",
    "prebuild": "npm run vendor:selkies",
    "build": "npm run check:node && tsc -b && vite build && vite build --config vite.selkies.config.ts",
    "postbuild": "python3 ../../scripts/write_frontend_build_stamp.py && npm run verify:selkies",
    "preview": "vite preview",
    "pretest": "npm run check:node",
    "test": "npm run test:types && vitest run",
    "test:watch": "vitest",
    "generate:api": "openapi-typescript ../../schemas/openapi/cbrowser_v1.json -o src/shared/api/generated/cbrowser_v1.d.ts",
    "test:types": "tsc -p tsconfig.test.json"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.106.0",
    "lucide-react": "^1.68.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "autoprefixer": "^10.4.20",
    "jsdom": "^30.1.3",
    "openapi-typescript": "^7.13.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.9.3",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  }
}
